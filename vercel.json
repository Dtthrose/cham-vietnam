{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/train-street", "destination": "/#train-street", "permanent": false },
    { "source": "/street-charm", "destination": "/#street-charm", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(images|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ]
}
